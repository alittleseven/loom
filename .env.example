# 织机 Loom —— edge 层 LLM API 配置模板
# 复制为 .env 后填写真实值。.env 已被 .gitignore 覆盖，真实密钥严禁提交。
# 路由降级链（ADR-0002，2026-08-29 Human 拍板），按序尝试，失败自动降级：
#   1. Opencode go · glm-5.3-flash        （OpenAI chat/completions 格式）
#   2. Opencode go · deepseek-v4-flash    （OpenAI chat/completions 格式）
#   3. Opencode go · qwen3.8-flash        （Anthropic messages 格式）
#   4. Alibaba Token Plan · qwen3.8-flash （OpenAI 兼容格式）
#   5. GLM Key · glm-5.3-flash            （OpenAI 兼容格式，兜底）
# 最终分档路由表随 P1b 盲测金标准集定版。

# ---- 1/2/3. Opencode go ----
LOOM_OCGO_API_KEY=
LOOM_OCGO_BASE_URL=https://opencode.ai/zen/go/v1/chat/completions
LOOM_OCGO_MODEL_ID=glm-5.3-flash
LOOM_OCGO_MODEL_ID2=deepseek-v4-flash
LOOM_OCGO_ALI_BASE_URL=https://opencode.ai/zen/go/v1/messages
LOOM_OCGO_ALI_MODEL_ID=qwen3.8-flash

# ---- 4. Alibaba Token Plan（OpenAI 兼容）----
LOOM_ALI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LOOM_ALI_API_KEY=
LOOM_ALI_MODEL_ID=qwen3.8-flash

# ---- 5. GLM 兜底 ----
LOOM_LLM_API_KEY=
LOOM_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LOOM_LLM_MODEL=glm-5.3-flash
