# 织机 Loom —— edge 层 LLM API 配置模板
# 用法：复制为 .env 后填写。.env 已被 .gitignore 覆盖，真实密钥严禁提交。
# 路由基线（ADR-0001，2026-08-29 Human 拍板）：四档统一 GLM-5.3-Flash；
# 最终路由表随 P1b 盲测金标准集定版，字段可能调整。

# 通用配置（各档位缺省回落到这里）
LOOM_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LOOM_LLM_MODEL=glm-5.3-flash
LOOM_LLM_API_KEY=

# 按档位覆盖（可选；v3.0 §5.3：渲染档/评审档/scribe 档/小档）
LOOM_LLM_MODEL_RENDER=
LOOM_LLM_MODEL_REVIEW=
LOOM_LLM_MODEL_SCRIBE=
LOOM_LLM_MODEL_SMALL=
